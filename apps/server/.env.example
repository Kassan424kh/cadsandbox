# CadSandbox server configuration — copy to apps/server/.env (development) or pass as container env.
# Never commit real values. Generate secrets with:  openssl rand -base64 32

# --- core ---------------------------------------------------------------------------------------
NODE_ENV=development                 # production enables Secure cookies, HSTS and strict checks
PORT=8787
HOST=0.0.0.0
PUBLIC_URL=http://localhost:5173     # public origin users open (https:// required in production)
BETTER_AUTH_SECRET=                  # ≥ 32 chars, required in production (dev: auto-generated in DATA_DIR)
TRUSTED_ORIGINS=                     # extra allowed origins, comma-separated (PUBLIC_URL is always trusted)
TRUST_PROXY=false                    # true behind Caddy/nginx — honour X-Forwarded-For from TRUSTED_PROXIES
TRUSTED_PROXIES=                     # e.g. 172.16.0.0/12 (docker network of the reverse proxy)

# --- database -----------------------------------------------------------------------------------
DATABASE_URL=                        # postgres://user:pass@host:5432/db — unset → embedded PGlite in DATA_DIR/pglite
DATABASE_POOL_MAX=10
DATABASE_SSL=false                   # true for managed Postgres over the network
DATA_DIR=./data                      # blobs, temp files, PGlite

# --- storage ------------------------------------------------------------------------------------
STORAGE_DRIVER=local                 # local | s3
STORAGE_ENCRYPTION_KEY=              # 32 random bytes, base64 → AES-256-GCM for blobs + collab docs at rest
STORAGE_ENCRYPTION_OLD_KEYS=         # previous keys (decrypt only) during rotation, comma-separated
S3_ENDPOINT=                         # e.g. https://fsn1.your-objectstorage.com (EU region!)
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PREFIX=blobs/

# --- e-mail (EU SMTP provider; unset in development → messages are printed to the log) -----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                    # true for implicit TLS (465); 587 uses STARTTLS (required)
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CadSandbox <no-reply@example.eu>"

# --- features & limits --------------------------------------------------------------------------
EMAIL_VERIFICATION=true              # require verified e-mail before login (keep on in production)
SIGNUP_ENABLED=true
SIGNUP_CAPTCHA=true                  # self-hosted proof-of-work at sign-up (no third party)
SIGNUP_CAPTCHA_DIFFICULTY=100000     # max number tried; ~0.2–1 s in a browser
BLOCKED_EMAIL_DOMAINS=               # extra domains refused at sign-up, comma-separated (disposable list is built in)
PUBLIC_SHARING=true                  # allow 'public' project visibility
COLLAB_ENABLED=true
PASSKEY_RP_ID=                       # defaults to the PUBLIC_URL hostname
PASSKEY_RP_NAME=CadSandbox
ADMIN_EMAILS=                        # comma-separated; these accounts become admin once their e-mail is verified
STORAGE_QUOTA_BYTES=1073741824       # per user (1 GiB)
MAX_PROJECTS_FREE=5                  # cloud projects per user (trash not counted)
COLLAB_MAX_MESSAGE_BYTES=16777216
COLLAB_MAX_DOC_BYTES=67108864        # a design above 64 MiB turns read-only
VISITOR_EGRESS_BYTES_PER_HOUR=2147483648  # bytes/hour per project served to visitors (public or link guests)

# --- legal pages (shown by the web app) ---------------------------------------------------------
LEGAL_IMPRINT_URL=/legal/imprint
LEGAL_PRIVACY_URL=/legal/privacy
LEGAL_TERMS_URL=/legal/terms
LEGAL_DPA_URL=/legal/dpa

# --- operations ---------------------------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=                          # self-hosted GlitchTip project DSN (https://<key>@errors.example.com/<id>); empty = no error reports
RATE_LIMIT=true
JOBS_ENABLED=true
# WEB_DIST_DIR=../web/dist           # served automatically when it exists
# MIGRATIONS_DIR=./drizzle

# --- off-site backups (docker-compose.dokploy.yml "backup" service; runbook apps/server/deploy/BACKUP-RESTORE.md) ---
# BACKUP_S3_ENDPOINT=https://s3.<second-eu-provider>   # a DIFFERENT provider/account than S3_ENDPOINT
# BACKUP_S3_BUCKET=cadsandbox-backup
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# RESTIC_PASSWORD=                     # keep an offline copy — backups are unrecoverable without it
# BACKUP_HEARTBEAT_URL=                # Uptime Kuma push / healthchecks URL: alerts when no backup for 26 h
# BACKUP_SOURCE_S3_ACCESS_KEY_ID=      # optional read-only key for the source bucket
# BACKUP_SOURCE_S3_SECRET_ACCESS_KEY=

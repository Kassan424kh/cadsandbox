{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CadSandbox",
  "version": "0.1.0",
  "identifier": "com.cadsandbox.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "corepack pnpm --filter @cadsandbox/web dev",
    "beforeBuildCommand": "corepack pnpm --filter @cadsandbox/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CadSandbox",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://cadsandbox.com wss://cadsandbox.com; object-src 'none'; base-uri 'none'",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Collaborative CAD & architecture studio",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
